<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Replaces nix-darwin's system.keyboard.remapCapsLockToEscape. hidutil
         mappings are per-boot, so re-apply at every login. 0x700000039 is caps
         lock, 0x700000029 is escape. -->
    <key>Label</key>
    <string>local.keyboard.capslock-to-escape</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/hidutil</string>
      <string>property</string>
      <string>--set</string>
      <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x700000029}]}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
